<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" prefWidth="350" prefHeight="355"
      style="-fx-background-color: #f9fafb; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px;"
      xmlns="http://javafx.com/javafx/21.0.6" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cesur.dam.inventarioappg1.controllers.CreateController">
    <padding><Insets top="17" right="19" bottom="16" left="19" /></padding>
    <Label text="Ficha de equipo"
           style="-fx-text-fill: #16212e; -fx-font-weight: bold; -fx-font-size: 20px;" />
    <VBox spacing="3">
        <Label text="ID automático" />
        <Spinner fx:id="spinnerId" prefWidth="135" prefHeight="30" accessibleText="ID automático" />
    </VBox>
    <VBox spacing="3">
        <Label text="Nombre" />
        <TextField fx:id="txtName" prefHeight="31" accessibleText="Nombre"
                   style="-fx-background-color: #f1f2f4; -fx-border-color: #d5d8dd; -fx-border-radius: 4px;" />
    </VBox>
    <VBox spacing="3">
        <Label text="Categoría" />
        <ChoiceBox fx:id="choiceCategory" maxWidth="Infinity" prefHeight="31" accessibleText="Categoría"
                   style="-fx-background-color: #f1f2f4; -fx-border-color: #d5d8dd; -fx-border-radius: 4px;" />
    </VBox>
    <CheckBox fx:id="chkAvailable" text="Disponible" />
    <HBox spacing="12">
        <VBox.margin><Insets top="9" /></VBox.margin>
        <Button text="Guardar" onAction="#save" defaultButton="true" prefWidth="142" prefHeight="38"
                maxWidth="Infinity" HBox.hgrow="ALWAYS"
                style="-fx-background-color: #1477db; -fx-background-radius: 6px; -fx-text-fill: white; -fx-cursor: hand;" />
        <Button text="Cancelar" onAction="#goBack" cancelButton="true" prefWidth="142" prefHeight="38"
                maxWidth="Infinity" HBox.hgrow="ALWAYS"
                style="-fx-background-color: #eef0f3; -fx-background-radius: 6px; -fx-border-color: #cdd0d5; -fx-border-radius: 6px; -fx-text-fill: #435164; -fx-cursor: hand;" />
    </HBox>
</VBox>
